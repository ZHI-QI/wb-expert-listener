# wb-expert-listener 配置模板：复制为 .env 并填写
# 全部留空也能跑（CLI 渠道 + OKF 本地知识库），凭证按渠道启用逐个补

# ---- 基础 ----
WB_PORT=18790
WB_LOG_LEVEL=info
# WB_DB_PATH=data/app.db
# WB_WORKSPACES_DIR=workspaces

# ---- 知识库（okf | ima，单选） ----
WB_KB_MODE=okf
# WB_KB_IMA_ENDPOINT=https://...

# ---- 管理员通知（飞书 webhook，脚本变更/告警推送） ----
# WB_ADMIN_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx

# ---- 渠道（默认仅 CLI 启用） ----
WB_AGENT_STUB=1
WB_CHANNEL_CLI=true
# WB_FEISHU_APP_ID=
# WB_FEISHU_APP_SECRET=
# WB_WECOM_BOT_ID=
# WB_WECOM_SECRET=
# WB_CLAWBOT_ENABLED=false
# WB_CLAWBOT_GATEWAY=http://127.0.0.1:18789
# WB_WECOM_KF_CORPID=
# WB_WECOM_KF_SECRET=
# WB_WECOM_KF_TOKEN=
# WB_WECOM_KF_AESKEY=

# ---- 脚本库 ----
UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
